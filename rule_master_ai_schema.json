            "duration": "Continuous",
            "modifiers": [
              {
                "target": "ac.deflection",
                "value": 2,
                "type": "Deflection",
                "condition": null
              }
            ],
            "damageParts": [],
            "modes": [],
            "ruleFlags": {},
