{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuleMasterAiResponseSchema",
  "description": "D&D 3.5e Rule Master AI (Gemini) sorgu çıktısı için resmi ve katı JSON yanıt şeması. Tüm yanıtlar 'entries' dizisi içinde döndürülmelidir.",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "description": "Sorgulanan kural, büyü, eşya veya varlığın (ve varsa alt güç/varyantlarının) nesne listesi.",
      "items": {
        "$ref": "#/definitions/RuleMasterEntry"
      }
    }
  },
  "definitions": {
    "RuleMasterEntry": {
      "type": "object",
      "required": ["name", "type", "source", "benefit", "description"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Varlığın resmi D&D 3.5e adı. Eğer bir alt güç veya koşullu varyant ise '↳ ' ile başlamalıdır.",
          "example": "Ring of Protection +2"
        },
        "type": {
          "type": "string",
          "enum": [
            "Feat",
            "Spell",
            "Weapon",
            "Armor",
            "Shield",
            "Wondrous Item",
            "Ring",
            "Potion",
            "Scroll",
            "Wand",
            "Consumable",
            "Maneuver",
            "Stance",
            "Race",
            "Deity"
          ],
          "description": "Varlığın kural kategorisi."
        },
        "slot": {
          "type": "string",
          "enum": [
            "None",
            "Main Hand",
            "Off-Hand/Shield",
            "Two Hands",
            "Armor",
            "Head",
            "Face",
            "Throat",
            "Shoulders",
            "Body",
            "Torso",
            "Waist",
            "Feet",
            "Arms",
            "Hands",
            "Ring",
            "Belt"
          ],
          "default": "None",
          "description": "Eşyanın vücut yuvası (Slot). Feat, büyü veya ırklar için 'None'."
        },
        "parent": {
          "type": "string",
          "default": "-",
          "description": "Eğer bu bir alt varyant (isChild) ise ana büyünün/eşyanın tam adı. Ana varlıklar için '-'."
        },
        "isChild": {
          "type": "boolean",
          "default": false,
          "description": "Büyü veya eşyanın alt modu / ikincil gücü olup olmadığı."
        },
        "childButtonLabel": {
          "type": "string",
          "description": "Alt varyant kartında gösterilecek kısa buton etiketi (örn: 'Undead (6d6)', 'Sacrifice 4 HP')."
        },
        "role": {
          "type": "string",
          "enum": [
            "General",
            "Offense / Spell",
            "Offense / Strike",
            "Offense / Weapon",
            "Defense / Armor",
            "Defense / Shield",
            "Tactical / Stance",
            "Tactical / Boost",
            "Secondary Power"
          ],
          "description": "Arayüzde kartın aksiyon rolü."
        },
        "source": {
          "type": "string",
          "description": "Resmi D&D 3.5e kitap adı ve sayfa numarası.",
          "example": "Player's Handbook v.3.5, p. 232"
        },
        "benefit": {
          "type": "string",
          "description": "Mekanik özet ve temel kural faydası."
        },
        "description": {
          "type": "string",
          "description": "Resmi kural kitabındaki tam metin."
        },
        "bonusType": {
          "type": "string",
          "default": "Untyped",
          "description": "Sağlanan bonusun D&D 3.5e tipi (Deflection, Enhancement, Armor, Shield, Resistance, Morale, Insight, Sacred, Profane, Dodge, Untyped).",
          "example": "Deflection"
        },
        "scope": {
          "type": "string",
          "default": "None / General",
          "description": "Etkinin kapsamı (AC, Saves, Melee Attacks, Spells, General)."
        },
        "prereq": {
          "type": "string",
          "default": "-",
          "description": "Feat veya manevra için resmi 3.5e önkoşulları (Pre-requisites)."
        },
        "action": {
          "type": "string",
          "default": "Passive",
          "description": "Aksiyon maliyeti (Standard Action, Move Action, Swift Action, Immediate Action, Free Action, Full-Round Action, Passive).",
          "example": "Standard Action"
        },
        "actionType": {
          "type": "string",
          "enum": ["passive", "standard", "move", "swift", "immediate", "full_round", "free"],
          "default": "passive",
          "description": "Kural motoru için normalleştirilmiş aksiyon tipi anahtarı."
        },
        "duration": {
          "type": "string",
          "default": "Continuous",
          "description": "Etki süresi (Instantaneous, 1 round/level, 10 min./level, 24 hours, Continuous)."
        },
        "cost": {
          "type": "number",
          "default": 0,
          "description": "Altın (gp) cinsinden piyasa değeri."
        },
        "weight": {
          "type": "number",
          "default": 0,
          "description": "Pound (lb) cinsinden ağırlık."
        },
        "dice": {
          "type": "string",
          "description": "Hasar veya iyileştirme zar formülü (örn: '1d8', '2d6', '6d6', '+2d6'). Tavla zarı sembolü içermez.",
          "example": "1d8"
        },
        "damageDice": {
          "type": "string",
          "description": "Silahlar için temel hasar zarı."
        },
        "extraDmg": {
          "type": "string",
          "description": "Ekstra hasar zarı formülü."
        },
        "critMin": {
          "type": "integer",
          "minimum": 10,
          "maximum": 20,
          "default": 20,
          "description": "Kritik tehdit aralığının başlangıcı (örn: 19-20 için 19)."
        },
        "critMult": {
          "type": "integer",
          "minimum": 2,
          "maximum": 5,
          "default": 2,
          "description": "Kritik hasar çarpanı (örn: x2 için 2, x3 için 3)."
        },
        "dmgType": {
          "type": "string",
          "description": "Hasar tipi (Slashing, Piercing, Bludgeoning, Fire, Cold, Electricity, Acid, Sonic, Force, Untyped / Divine Light)."
        },
        "strBonus": { "type": "number", "default": 0 },
        "dexBonus": { "type": "number", "default": 0 },
        "conBonus": { "type": "number", "default": 0 },
        "intBonus": { "type": "number", "default": 0 },
        "wisBonus": { "type": "number", "default": 0 },
        "chaBonus": { "type": "number", "default": 0 },
        "acBonus": { "type": "number", "default": 0 },
        "hpBonus": { "type": "number", "default": 0 },
        "attBonus": { "type": "number", "default": 0 },
        "dmgBonus": { "type": "number", "default": 0 },
        "fortBonus": { "type": "number", "default": 0 },
        "refBonus": { "type": "number", "default": 0 },
        "willBonus": { "type": "number", "default": 0 },
        "skillBonus": { "type": "number", "default": 0 },
        "clBonus": { "type": "number", "default": 0 },
        "speedBonus": { "type": "number", "default": 0 },
        "range": {
          "type": "string",
          "description": "Menzil (Personal, Touch, Close [25 ft. + 5 ft./2 levels], Medium [100 ft. + 10 ft./level], Long [400 ft. + 40 ft./level])."
        },
        "school": {
          "type": "string",
          "description": "Büyü okulu (Abjuration, Conjuration, Divination, Enchantment, Evocation, Illusion, Necromancy, Transmutation, Universal)."
        },
        "level": {
          "type": ["integer", "string"],
          "description": "Büyü veya manevra seviyesi (0-9)."
        },
        "discipline": {
          "type": "string",
          "description": "Tome of Battle disiplini (Desert Wind, Devoted Spirit, Diamond Mind, Iron Heart, Setting Sun, Shadow Hand, Stone Dragon, Tiger Claw, White Raven)."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Katalog ve arama filtreleme etiketleri (örn: ['ring', 'deflection', 'magic item'])."
        },
        "isLight": {
          "type": "boolean",
          "description": "Hafif silah (Light Weapon) olup olmadığı."
        },
        "finessable": {
          "type": "boolean",
          "description": "Weapon Finesse ile DEX bonusu alıp almadığı (Rapier, Dagger, Whip vb.)."
        },
        "isFighterBonusFeat": {
          "type": "boolean",
          "description": "Savaşçı (Fighter) bonus hüneri olarak seçilip seçilemeyeceği (PHB Tablo 5-1)."
        },
        "featType": {
          "type": "string",
          "enum": ["General", "Item Creation", "Metamagic", "Special"],
          "description": "Feat alt türü."
        },
        "sizeModifier": {
          "type": "object",
          "properties": {
            "targetType": { "type": "string", "enum": ["weapon", "creature"] },
            "scaling": {
              "type": "object",
              "properties": {
                "steps": { "type": "integer" }
              }
            }
          },
          "description": "Büyüklük basamağı modifikasyonu (örn: Enlarge Person, Mighty Wallop)."
        },
        "ruleFlags": {
          "type": "object",
          "description": "Kural motoru deklaratif bayrakları (örn: {'ignoresHardness': true, 'touchAttack': true})."
        },
        "combatModifiers": {
          "type": "object",
          "description": "Saldırı veya savunma zar modifikatörleri."
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "desc"],
            "properties": {
              "name": { "type": "string" },
              "desc": { "type": "string" }
            }
          },
          "description": "Irk özellikleri (Racial Traits)."
        },
        "domains": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tanrı alanları (Deity Domains)."
        }
      }
    }
  },
  "canonicalExamples": [
    {
      "category": "Magic Item / Ring (Yüzük Örneği)",
      "payload": {
        "entries": [
          {
            "name": "Ring of Protection +2",
            "type": "Ring",
            "slot": "Ring",
            "parent": "-",
            "isChild": false,
            "role": "Defense / Armor",
            "source": "Dungeon Master's Guide v.3.5, p. 232",
            "benefit": "+2 Deflection bonus to Armor Class.",
            "description": "This ring offers continual magical protection in the form of a deflection bonus of +2 to AC.",
            "bonusType": "Deflection",
            "scope": "AC",
            "acBonus": 2,
            "cost": 8000,
            "weight": 0,
            "action": "Passive",
            "actionType": "passive",
            "duration": "Continuous",
            "tags": ["ring", "magic item", "deflection", "ac"]
          }
        ]
      }
    },
    {
      "category": "Spell with Conditional Child Variant (Büyü & Alt Varyant Örneği)",
      "payload": {
        "entries": [
          {
            "name": "Searing Light",
            "type": "Spell",
            "level": 3,
            "school": "Evocation",
            "slot": "None",
            "parent": "-",
            "isChild": false,
            "role": "Offense / Spell",
            "source": "Player's Handbook v.3.5, p. 275",
            "benefit": "Deals 1d8 per two caster levels (max 5d8) to non-undead creatures.",
            "description": "Focusing divine power like a ray of the sun, you project a blast of light from your open palm. You must succeed on a ranged touch attack to strike a target.",
            "bonusType": "Untyped",
            "scope": "Target: Creature",
            "range": "Medium (100 ft. + 10 ft./level)",
            "action": "Standard Action",
            "actionType": "standard",
            "duration": "Instantaneous",
            "dice": "3d8",
            "damageDice": "3d8",
            "critMin": 20,
            "critMult": 2,
            "dmgType": "Untyped / Divine Light",
            "tags": ["spell", "evocation", "divine"]
          },
          {
            "name": "↳ Searing Light (Undead)",
            "type": "Spell",
            "level": 3,
            "school": "Evocation",
            "slot": "None",
            "parent": "Searing Light",
            "isChild": true,
            "childButtonLabel": "Undead (6d6)",
            "role": "Secondary Power",
            "source": "Player's Handbook v.3.5, p. 275",
            "benefit": "Deals 1d6 per caster level (max 10d6) to undead creatures.",
            "description": "Against undead, searing light deals 1d6 points of damage per caster level (maximum 10d6).",
            "bonusType": "Untyped",
            "scope": "Target: Undead",
            "range": "Medium (100 ft. + 10 ft./level)",
            "action": "Standard Action",
            "actionType": "standard",
            "duration": "Instantaneous",
            "dice": "6d6",
            "damageDice": "6d6",
            "critMin": 20,
            "critMult": 2,
            "dmgType": "Untyped / Divine Light",
            "tags": ["spell", "child", "evocation", "undead"]
          }
        ]
      }
    },
    {
      "category": "Feat (Fighter Bonus Hüneri Örneği)",
      "payload": {
        "entries": [
          {
            "name": "Power Attack",
            "type": "Feat",
            "slot": "None",
            "parent": "-",
            "isChild": false,
            "role": "General",
            "source": "Player's Handbook v.3.5, p. 98",
            "prereq": "Str 13, base attack bonus +1.",
            "benefit": "Trade attack bonus for melee damage bonus (1 for 1 with one-handed, 1 for 2 with two-handed weapons).",
            "description": "On your action, before making attack rolls for a round, you may choose to subtract a number from all melee attack rolls and add the same number to all melee damage rolls.",
            "bonusType": "Untyped",
            "scope": "Melee Damage",
            "action": "Free Action",
            "actionType": "free",
            "duration": "1 round",
            "isFighterBonusFeat": true,
            "featType": "General",
            "tags": ["feat", "fighter", "offense"]
          }
        ]
      }
    },
    {
      "category": "Weapon (Silah Örneği)",
      "payload": {
        "entries": [
          {
            "name": "Longsword +1",
            "type": "Weapon",
            "slot": "Main Hand",
            "parent": "-",
            "isChild": false,
            "role": "Offense / Weapon",
            "source": "Dungeon Master's Guide v.3.5, p. 222",
            "benefit": "+1 Enhancement bonus on attack and damage rolls.",
            "description": "A masterwork longsword magically enhanced to grant a +1 enhancement bonus.",
            "bonusType": "Enhancement",
            "scope": "Attack and Damage",
            "attBonus": 1,
            "dmgBonus": 1,
            "dice": "1d8",
            "damageDice": "1d8",
            "critMin": 19,
            "critMult": 2,
            "dmgType": "Slashing",
            "cost": 2315,
            "weight": 4,
            "action": "Standard Action",
            "actionType": "standard",
            "duration": "Continuous",
            "isLight": false,
            "finessable": false,
            "tags": ["weapon", "magic item", "slashing", "martial"]
          }
        ]
      }
    },
    {
      "category": "Maneuver (Tome of Battle Manevra Örneği)",
      "payload": {
        "entries": [
          {
            "name": "Mountain Tombstone Strike",
            "type": "Maneuver",
            "discipline": "Stone Dragon",
            "level": 9,
            "slot": "None",
            "parent": "-",
            "isChild": false,
            "role": "Offense / Strike",
            "source": "Tome of Battle, p. 84",
            "prereq": "None (Stone Dragon maneuvers do not require Stone Dragon prerequisites).",
            "benefit": "Melee strike deals weapon damage plus 2d6 points of Constitution damage.",
            "description": "You strike your foe with devastating force, crushing bone, shattering armor, and causing internal trauma that deals 2d6 Constitution damage.",
            "bonusType": "Untyped",
            "scope": "Melee Only",
            "dice": "2d6",
            "damageDice": "2d6",
            "dmgType": "Constitution Ability Damage",
            "action": "1 standard action",
            "actionType": "standard",
            "duration": "Instantaneous",
            "tags": ["maneuver", "strike", "stone dragon"]
          }
        ]
      }
    }
  ]
}
