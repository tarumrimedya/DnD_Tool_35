{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuleMasterAiResponseSchemaV3",
  "description": "Pure Canonical V3 (schemaVersion: 3) response schema for the D&D 3.5e Rule Master AI and Rule Crafter. Return every result inside `entries` using V3 effects[] blocks, choices[], powers[] and blueprint sub-objects. Legacy V2 modifiers[], damageParts[], defenses[], resources[] and modes[] are banned.",
  "type": "object",
  "required": [
    "entries"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "description": "Pure Canonical V3 entries for the queried rule, spell, feat, item, or entity.",
      "items": {
        "$ref": "#/definitions/RuleMasterEntryV3"
      }
    }
  },
  "definitions": {
    "RuleMasterEntryV3": {
      "type": "object",
      "description": "One Pure Canonical V3 entry. Mechanics live ONLY in effects[] (plus powers[] for activated abilities and choices[] for @Choice inputs). Narrative-only entries keep effects: [].",
      "required": [
        "schemaVersion",
        "id",
        "blueprint",
        "name"
      ],
      "additionalProperties": true,
      "not": {
        "anyOf": [
          {
            "required": [
              "modifiers"
            ]
          },
          {
            "required": [
              "damageParts"
            ]
          },
          {
            "required": [
              "defenses"
            ]
          },
          {
            "required": [
              "resources"
            ]
          }
        ]
      },
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "id": {
          "type": "string",
          "description": "Immutable kebab/snake-case id (e.g. \"feat-weapon-focus\"). References match by id, never by display name."
        },
        "blueprint": {
          "type": "string",
          "enum": [
            "weapon",
            "armor",
            "wondrous",
            "spell",
            "feat",
            "buff",
            "class",
            "item_mod",
            "race",
            "deity",
            "domain",
            "monster"
          ]
        },
        "name": {
          "type": "string",
          "description": "Official D&D 3.5e English name."
        },
        "type": {
          "type": "string",
          "description": "Display type (Feat, Spell, Domain, Homebrew, ...)."
        },
        "category": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "Book and page, e.g. \"Complete Warrior p.106\"."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "identity",
              "chassis",
              "delivery",
              "lifecycle",
              "effects",
              "powers",
              "grants",
              "progression",
              "prereqs"
            ]
          }
        },
        "text": {
          "type": [
            "string",
            "object"
          ],
          "description": "Rules text (string) or { summary }."
        },
        "featKind": {
          "type": "string",
          "enum": [
            "feat",
            "acf",
            "substitution",
            "trait",
            "flaw"
          ]
        },
        "timesSelectable": {
          "type": [
            "number",
            "string"
          ],
          "description": "1, N, or \"perWeaponOrSchool\" for repeatable @Choice feats."
        },
        "prerequisites": {
          "type": [
            "string",
            "object"
          ]
        },
        "baseItemId": {
          "type": "string",
          "description": "Composite gear base item id (e.g. \"katana\")."
        },
        "material": {
          "type": "string",
          "description": "Special material id (e.g. \"adamantine\", \"mithral\", \"cold_iron\")."
        },
        "enhancementBonus": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "enhancements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Special ability ids (e.g. \"keen\", \"flaming_burst\")."
        },
        "ruleFlags": {
          "type": "object",
          "additionalProperties": true
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChoiceV3"
          }
        },
        "effects": {
          "type": "array",
          "description": "Atomic V3 effect blocks (stat, roll, attack, defense, effect, resource, when, table, carrier).",
          "items": {
            "$ref": "#/definitions/EffectBlockV3"
          }
        },
        "powers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PowerV3"
          }
        },
        "spell": {
          "$ref": "#/definitions/SpellV3"
        },
        "delivery": {
          "$ref": "#/definitions/DeliveryV3"
        },
        "lifecycle": {
          "$ref": "#/definitions/LifecycleV3"
        },
        "weapon": {
          "$ref": "#/definitions/WeaponV3"
        },
        "armor": {
          "$ref": "#/definitions/ArmorV3"
        },
        "item": {
          "$ref": "#/definitions/ItemV3"
        },
        "itemModifier": {
          "$ref": "#/definitions/ItemModifierV3"
        },
        "progression": {
          "$ref": "#/definitions/ProgressionV3"
        },
        "grants": {
          "$ref": "#/definitions/GrantsV3"
        },
        "race": {
          "$ref": "#/definitions/RaceV3"
        },
        "monster": {
          "$ref": "#/definitions/MonsterV3"
        }
      }
    },
    "ChoiceV3": {
      "type": "object",
      "required": [
        "id",
        "key",
        "label"
      ],
      "additionalProperties": true,
      "description": "@Choice input resolved when the entry is taken. Blocks reference it via \"@Choice\" or choice.* targets (choice.ability.1, choice.skill.1, ...).",
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "enum": [
            "weapon",
            "skill",
            "ability",
            "school",
            "energy",
            "custom"
          ]
        },
        "label": {
          "type": "string"
        },
        "count": {
          "type": "number",
          "minimum": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "EffectBlockV3": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": true,
      "description": "Discriminated by `type`. Unknown keys are tolerated (Rule Crafter UI state) but only the documented keys carry mechanics.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "stat",
            "roll",
            "attack",
            "defense",
            "effect",
            "resource",
            "when",
            "table",
            "carrier"
          ]
        },
        "condition": {
          "type": [
            "string",
            "object"
          ]
        },
        "summary": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "stat"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/definitions/StatBlockV3"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "roll"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/definitions/RollBlockV3"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "attack"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/definitions/AttackBlockV3"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "defense"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/definitions/DefenseBlockV3"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "effect"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/definitions/RuleEffectBlockV3"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "resource"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/definitions/ResourceBlockV3"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "when"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/definitions/WhenBlockV3"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/definitions/TableBlockV3"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "carrier"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/definitions/CarrierBlockV3"
          }
        }
      ]
    },
    "StatBlockV3": {
      "type": "object",
      "required": [
        "targets",
        "mode"
      ],
      "additionalProperties": true,
      "description": "Numeric modifier. ALWAYS plural `targets: string[]` + `btype` (never singular target/type). Targets must be canonical keys from tools/verify_v3_corpus.js (ac.deflection, atk.all, save.will, skill.hide, choice.ability.1, ...).",
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "btype": {
          "type": "string",
          "enum": [
            "Untyped",
            "Dodge",
            "Circumstance",
            "Penalty",
            "Racial",
            "Synergy",
            "Enhancement",
            "Luck",
            "Morale",
            "Sacred",
            "Profane",
            "Insight",
            "Competence",
            "Resistance",
            "Deflection",
            "Alchemical",
            "Inherent",
            "Armor",
            "Armor Enhancement",
            "Shield",
            "Shield Enhancement",
            "Natural Armor",
            "Natural Armor Enhancement",
            "Size",
            "Exalted",
            "Perfection"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "flat",
            "stat",
            "perCL",
            "formula",
            "replaceStat"
          ]
        },
        "value": {
          "type": "number",
          "description": "Flat value (mode flat) or per-step amount (mode perCL)."
        },
        "formula": {
          "type": "string",
          "description": "Engine formula (@cl, @level, @classLevel, @strMod..@chaMod, floor/min/max/clamp)."
        },
        "cap": {
          "type": [
            "number",
            "string",
            "null"
          ],
          "description": "Optional cap (number, \"@classLevel\", or null)."
        },
        "per": {
          "type": "number",
          "description": "perCL: caster levels per step."
        },
        "min": {
          "type": "number",
          "description": "perCL: floor."
        },
        "max": {
          "type": "number",
          "description": "perCL: ceiling."
        },
        "condition": {
          "type": [
            "string",
            "object"
          ],
          "description": "Situational qualifier string, or { toggle: \"<key>\" }."
        },
        "swapTarget": {
          "type": "string",
          "enum": [
            "atk.melee.abilityMod",
            "atk.ranged.abilityMod",
            "atk.thrown.abilityMod",
            "atk.touch.abilityMod",
            "grapple.abilityMod",
            "dmg.melee.abilityMod",
            "dmg.ranged.abilityMod",
            "save.fort.abilityMod",
            "save.ref.abilityMod",
            "save.will.abilityMod",
            "ac.abilityMod",
            "initiative.abilityMod",
            "hp.abilityMod",
            "concentration.abilityMod",
            "choice.skill.1.abilityMod",
            "skill.appraise.abilityMod",
            "skill.autohypnosis.abilityMod",
            "skill.balance.abilityMod",
            "skill.bluff.abilityMod",
            "skill.climb.abilityMod",
            "skill.concentration.abilityMod",
            "skill.craft.abilityMod",
            "skill.decipher-script.abilityMod",
            "skill.diplomacy.abilityMod",
            "skill.disable-device.abilityMod",
            "skill.disguise.abilityMod",
            "skill.escape-artist.abilityMod",
            "skill.forgery.abilityMod",
            "skill.gather-information.abilityMod",
            "skill.handle-animal.abilityMod",
            "skill.heal.abilityMod",
            "skill.hide.abilityMod",
            "skill.intimidate.abilityMod",
            "skill.jump.abilityMod",
            "skill.knowledge.abilityMod",
            "skill.knowledge-psionics.abilityMod",
            "skill.listen.abilityMod",
            "skill.move-silently.abilityMod",
            "skill.open-lock.abilityMod",
            "skill.perform.abilityMod",
            "skill.profession.abilityMod",
            "skill.psicraft.abilityMod",
            "skill.ride.abilityMod",
            "skill.search.abilityMod",
            "skill.sense-motive.abilityMod",
            "skill.sleight-of-hand.abilityMod",
            "skill.speak-language.abilityMod",
            "skill.spellcraft.abilityMod",
            "skill.spot.abilityMod",
            "skill.survival.abilityMod",
            "skill.swim.abilityMod",
            "skill.truespeak.abilityMod",
            "skill.tumble.abilityMod",
            "skill.use-magic-device.abilityMod",
            "skill.use-psionic-device.abilityMod",
            "skill.use-rope.abilityMod",
            "bab",
            "spell.dc.abilityMod",
            "spell.bonusSlots.abilityMod"
          ]
        },
        "subOp": {
          "type": "string",
          "enum": [
            "max",
            "replace",
            "add"
          ]
        },
        "fromStat": {
          "type": "string",
          "enum": [
            "str",
            "dex",
            "con",
            "int",
            "wis",
            "cha"
          ]
        },
        "toStat": {
          "type": "string",
          "enum": [
            "str",
            "dex",
            "con",
            "int",
            "wis",
            "cha",
            "0.5*str",
            "0.5*dex",
            "0.5*int",
            "0.5*wis",
            "0.5*cha",
            "1.5*str",
            "1.5*dex",
            "choice.abilityMod",
            "@level",
            "@classLevel",
            "@cl"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "all",
            "finessable",
            "simple_or_natural",
            "thrown",
            "bow_or_crossbow",
            "chosen_weapon",
            "discipline_weapons",
            "light_or_no_armor",
            "not_flat_footed",
            "mind_affecting"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "replaceStat"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "swapTarget",
              "targets",
              "subOp",
              "fromStat",
              "toStat",
              "scope"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "perCL"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "value",
              "per",
              "min",
              "max"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "formula"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "formula"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "flat"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "RollBlockV3": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": true,
      "description": "Dice payload: damage, healing, temporary hit points, ongoing damage or fast healing.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Damage",
            "Healing",
            "Temp HP",
            "Ongoing / Round",
            "Fast Healing"
          ]
        },
        "count": {
          "type": "number"
        },
        "die": {
          "type": "string",
          "description": "d4..d20, or \"flat\" for a fixed number."
        },
        "flat": {
          "type": "number",
          "description": "Flat bonus added to the dice."
        },
        "dmgType": {
          "type": "string",
          "description": "Fire, Cold, Acid, Electricity, Sonic, Force, Precision, Untyped, ..."
        },
        "scaling": {
          "type": "string",
          "enum": [
            "flat",
            "perCL",
            "perVar",
            "formula"
          ]
        },
        "per": {
          "type": "number"
        },
        "amount": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "varKey": {
          "type": "string",
          "description": "perVar: the @resource dial key."
        },
        "dice": {
          "type": "string",
          "description": "scaling formula: dice expression (e.g. \"10 * @absorbed_spell_level\")."
        },
        "save": {
          "type": "string",
          "description": "e.g. \"Reflex half\"."
        },
        "tempHpFormula": {
          "type": "string",
          "description": "Derived by the Rule Crafter for Temp HP rolls."
        }
      }
    },
    "AttackBlockV3": {
      "type": "object",
      "required": [
        "attackMode"
      ],
      "additionalProperties": true,
      "description": "Natural attacks, extra attacks, unarmed die progression, weapon imbue/strike bypass.",
      "properties": {
        "attackMode": {
          "type": "string"
        },
        "natKind": {
          "type": "string",
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "count": {
          "type": "number"
        },
        "weaponName": {
          "type": "string"
        },
        "dice": {
          "type": "string"
        },
        "dmgType": {
          "type": "string"
        },
        "penalty": {
          "type": "number"
        },
        "rider": {
          "type": "string"
        }
      }
    },
    "DefenseBlockV3": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": true,
      "description": "Defensive trait. Energy Resistance/DR use `value` + `what` (energy type or DR bypass; \"@Choice\" reads the chosen energy). Spell Resistance uses srMode flat|level (10 + @level). Fast healing is a roll block (kind \"Fast Healing\").",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "Immunity",
            "Condition Immunity",
            "DR",
            "Energy Resistance",
            "Spell Resistance",
            "Concealment %",
            "Sense / Movement",
            "Vulnerability",
            "Size Change",
            "State Flag"
          ]
        },
        "what": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "srMode": {
          "type": "string",
          "enum": [
            "flat",
            "level"
          ]
        },
        "steps": {
          "type": "number"
        },
        "flag": {
          "type": "string"
        }
      }
    },
    "RuleEffectBlockV3": {
      "type": "object",
      "required": [
        "effectKind"
      ],
      "additionalProperties": true,
      "description": "Rule switch (ruleSwitchFlags from rulesets/dnd35.js), narrative rule, or linked spell cast.",
      "properties": {
        "effectKind": {
          "type": "string",
          "enum": [
            "ruleSwitch",
            "rule",
            "castSpell",
            "linkedSpell",
            "castEvolution",
            "grant",
            "grantFeat",
            "proficiency",
            "familiarity",
            "bonusSlot",
            "trait",
            "reroll"
          ],
          "description": "Primary kinds: ruleSwitch (engine flag), rule (narrative/manual rule), castSpell (spell-like cast). The rest mirror engine-supported corpus kinds."
        },
        "flag": {
          "type": "string",
          "description": "ruleSwitch only: one of noAutoFailFortSaveOnNat1, shieldToTouchAc, monkeyGrip, naturalSpell, uncannyDodge, ignoreArmorSpeedPenalty, oneHandedOffHandAsLight, tacticalSlider, or a documented engine flag."
        },
        "label": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "targetId": {
          "type": "string",
          "description": "proficiency: token weapon:simple | weapon:martial | weapon:exotic | weapon:<wpn-id> | armor:light|medium|heavy | shield:shield|tower. familiarity: immutable weapon id (wpn-*)."
        },
        "treatAs": {
          "type": "string",
          "enum": ["martial"],
          "description": "familiarity only: category the (exotic) weapon counts as for proficiency (PHB racial Weapon Familiarity)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effectKind": {
                "const": "ruleSwitch"
              }
            },
            "required": [
              "effectKind"
            ]
          },
          "then": {
            "required": [
              "flag"
            ]
          }
        }
      ]
    },
    "ResourceBlockV3": {
      "type": "object",
      "required": [
        "name",
        "varKey",
        "resMode"
      ],
      "additionalProperties": true,
      "description": "Declares a pool/dial exposed as @varKey to formulas and as a spendable pool to powers (usage.mode \"resourcePool\").",
      "properties": {
        "name": {
          "type": "string"
        },
        "varKey": {
          "type": "string"
        },
        "resMode": {
          "type": "string",
          "enum": [
            "spend",
            "invest",
            "dial",
            "choice",
            "focus",
            "buffer"
          ]
        },
        "scaling": {
          "type": "string",
          "enum": [
            "flat",
            "level",
            "halfLevel",
            "plusMod",
            "halfLvlPlusMod",
            "twoPerLvlPlusMod"
          ]
        },
        "maxMode": {
          "type": "string",
          "enum": [
            "flat",
            "bab",
            "level",
            "spellLvl",
            "pool"
          ]
        },
        "max": {
          "type": "number"
        },
        "ability": {
          "type": "string",
          "enum": [
            "str",
            "dex",
            "con",
            "int",
            "wis",
            "cha"
          ]
        },
        "reset": {
          "type": "string",
          "enum": [
            "atWill",
            "cooldown",
            "perEncounter",
            "perDay"
          ]
        },
        "cooldownText": {
