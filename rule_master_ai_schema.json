    },
    {
      "category": "Weapon (Canonical V2 Composite Weapon Example)",
      "payload": {
        "entries": [
          {
            "schemaVersion": 2,
            "id": "wpn_longsword_plus_1",
            "baseItemId": "wpn_longsword",
            "name": "+1 Longsword",
            "type": "Weapon",
            "slot": "Main Hand",
            "role": "Offense / Weapon",
            "source": "Dungeon Master's Guide v.3.5, p. 222",
            "benefit": "+1 Enhancement bonus on attack and damage rolls (1d8, 19-20/x2 Slashing).",
            "description": "A masterwork longsword magically enhanced to grant a +1 enhancement bonus on attack and damage rolls.",
            "enhancementBonus": 1,
