{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuleMasterAiResponseSchemaV2",
  "description": "D&D 3.5e Rule Master AI (Gemini) sorgu çıktısı için Kanonik V2 JSON yanıt şeması (schemaVersion: 2). Tüm yanıtlar 'entries' dizisi içinde döndürülmelidir. Eski sabit bonus sütunları (strBonus, acBonus vb.) veya ayrı '↳' alt satırları kullanılmaz; tüm etkiler 'modifiers', 'damageParts' ve 'modes' dizilerinde tanımlanır.",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "description": "Sorgulanan kural, büyü, eşya veya varlığın Kanonik V2 nesne listesi.",
      "items": {
        "$ref": "#/definitions/RuleMasterEntryV2"
      }
    }
  },
  "definitions": {
    "ModifierEntryV2": {
      "type": "object",
      "required": ["target", "type"],
      "properties": {
        "target": {
          "type": "string",
          "description": "Hedeflenen stat veya mekanik anahtarı (örn: 'ability.str', 'ability.dex', 'ability.con', 'ability.int', 'ability.wis', 'ability.cha', 'ac', 'ac.armor', 'ac.shield', 'ac.deflection', 'ac.natural', 'ac.dodge', 'attack.all', 'attack.melee', 'attack.ranged', 'damage.all', 'damage.melee', 'save.all', 'save.fort', 'save.ref', 'save.will', 'init', 'speed.land', 'hp', 'casterLevel', 'skill.all', 'skill.tumble')."
        },
        "value": {
          "type": "number",
          "description": "Sabit sayısal bonus veya ceza değeri."
        },
        "formula": {
          "type": "string",
          "description": "Dinamik ölçeklenen bonus formülü (örn: 'min(5, 2 + floor(casterLevel / 6))'). Sabit 'value' yerine kullanılabilir."
        },
        "type": {
          "type": "string",
          "enum": [
            "Enhancement",
            "Deflection",
            "Armor",
            "Shield",
            "Natural Armor",
            "Resistance",
            "Morale",
            "Luck",
            "Insight",
            "Sacred",
            "Profane",
            "Competence",
            "Circumstance",
            "Alchemical",
            "Racial",
            "Size",
            "Dodge",
            "Inherent",
            "Untyped",
            "Penalty"
          ],
          "default": "Untyped",
          "description": "D&D 3.5e resmi bonus tipi (Dodge, Circumstance ve Untyped hariç aynı tipteki bonuslar birbiriyle toplanmaz, en yükseği alınır)."
        },
        "condition": {
          "type": ["string", "null"],
          "default": null,
          "description": "Varsa durumsal koşul (örn: 'vs evil', 'while charging', null)."
        }
      }
    },
    "DamagePartEntryV2": {
      "type": "object",
      "required": ["dice", "type"],
      "properties": {
        "dice": {
          "type": "string",
          "description": "Hasar veya iyileştirme zar formülü (örn: '1d8', '2d6', 'min(10, casterLevel)d6'). Tavla zarı sembolü kesinlikle içermez."
        },
        "bonus": {
          "type": "number",
          "default": 0,
          "description": "Zara eklenen sabit sayısal hasar bonusu."
        },
        "type": {
          "type": "string",
          "default": "Untyped",
          "description": "Hasar tipi (Slashing, Piercing, Bludgeoning, Fire, Cold, Electricity, Acid, Sonic, Force, Positive Energy, Negative Energy, Holy, Unholy, Untyped / Divine Light)."
        },
        "multiplyOnCrit": {
          "type": "boolean",
          "default": false,
          "description": "Kritik vuruşta bu zarın çarpanla çarpılıp çarpılmayacağı (Temel silah hasarı için true, Flaming gibi ekstra enerji zarları için false)."
        },
        "onCritOnly": {
          "type": "boolean",
          "default": false,
          "description": "Sadece kritik vuruş gerçekleştiğinde tetiklenen ekstra zar olup olmadığı (örn: Flaming Burst +1d10)."
        },
        "source": {
          "type": "string",
          "description": "Hasar parçasının kaynağı (örn: 'Base Weapon', 'Flaming', 'Mountain Hammer')."
        }
      }
    },
    "ModeEntryV2": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Modun benzersiz slug kimliği (örn: 'vs_undead', 'two_handed', 'sacrifice_4_hp')."
        },
        "name": {
          "type": "string",
          "description": "Arayüzde mod butonunda gösterilecek kısa etiket (örn: 'Undead (1d6/CL)', 'Two-Handed', 'Sacrifice 4 HP (+2d6)')."
        },
        "actionType": {
          "type": "string",
          "enum": ["passive", "standard", "move", "swift", "immediate", "full_round", "free"],
          "default": "standard"
        },
        "grip": {
          "type": "string",
          "enum": ["one_handed", "two_handed", "off_hand", "none"],
          "default": "none"
        },
        "isRanged": {
          "type": "boolean",
          "default": false
        },
        "range": {
          "type": "string"
        },
        "benefit": {
          "type": "string",
          "description": "Bu modun veya ikincil gücün kısa mekanik açıklaması."
        },
        "damageParts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DamagePartEntryV2"
          },
          "default": []
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModifierEntryV2"
          },
          "default": []
        },
        "save": {
          "type": ["string", "null"],
          "default": null
        }
      }
    },
    "RuleMasterEntryV2": {
      "type": "object",
      "required": ["schemaVersion", "id", "name", "type", "source", "benefit", "description", "modifiers", "damageParts", "modes"],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "enum": [2],
          "default": 2,
          "description": "Kanonik V2 şema sürümü (her zaman 2)."
        },
        "id": {
          "type": "string",
          "description": "Değişmez benzersiz slug kimliği (örn: 'item_ring_of_protection_2', 'spell_searing_light', 'feat_power_attack').",
          "example": "item_ring_of_protection_2"
        },
        "baseItemId": {
          "type": ["string", "null"],
          "default": null,
          "description": "Bileşik silah veya zırhlar için temel SRD eşya kimliği (örn: 'wpn_longsword', 'arm_mithral_shirt')."
        },
        "name": {
          "type": "string",
          "description": "Varlığın resmi D&D 3.5e adı. Alt güçler ayrı satır olarak değil, bu varlığın 'modes' dizisi içinde tanımlanır.",
          "example": "Ring of Protection +2"
        },
        "type": {
          "type": "string",
          "enum": [
            "Feat",
            "Spell",
            "Weapon",
            "Armor",
            "Shield",
            "Wondrous Item",
            "Ring",
            "Potion",
            "Scroll",
            "Wand",
            "Consumable",
            "Maneuver",
            "Stance",
            "Race",
            "Deity"
          ],
          "description": "Varlığın kural kategorisi."
        },
        "slot": {
          "type": "string",
          "enum": [
            "None",
            "Main Hand",
            "Off-Hand/Shield",
            "Two Hands",
            "Armor",
            "Head",
            "Face",
            "Throat",
            "Shoulders",
            "Body",
            "Torso",
            "Waist",
            "Feet",
            "Arms",
            "Hands",
            "Ring",
            "Belt"
          ],
          "default": "None",
          "description": "Eşyanın vücut yuvası (Slot). Feat, büyü veya ırklar için 'None'."
        },
        "role": {
          "type": "string",
          "enum": [
            "General",
            "Offense / Spell",
            "Offense / Strike",
            "Offense / Weapon",
            "Defense / Armor",
            "Defense / Shield",
            "Tactical / Stance",
            "Tactical / Boost"
          ],
          "default": "General",
          "description": "Arayüzde kartın aksiyon rolü."
        },
        "source": {
          "type": "string",
          "description": "Resmi D&D 3.5e kitap adı ve sayfa numarası.",
          "example": "Dungeon Master's Guide v.3.5, p. 232"
        },
        "benefit": {
          "type": "string",
          "description": "Mekanik özet ve temel kural faydası."
        },
        "description": {
          "type": "string",
          "description": "Resmi kural kitabındaki tam metin."
        },
        "prereq": {
          "type": "string",
          "default": "-",
          "description": "Feat veya manevra için resmi 3.5e önkoşulları (Pre-requisites)."
        },
        "action": {
          "type": "string",
          "default": "Passive",
          "description": "Aksiyon maliyeti (Standard Action, Move Action, Swift Action, Immediate Action, Free Action, Full-Round Action, Passive)."
        },
        "actionType": {
          "type": "string",
          "enum": ["passive", "standard", "move", "swift", "immediate", "full_round", "free"],
          "default": "passive",
          "description": "Kural motoru için normalleştirilmiş aksiyon tipi anahtarı."
        },
        "duration": {
          "type": "string",
          "default": "Continuous",
          "description": "Etki süresi (Instantaneous, 1 round/level, 10 min./level, 24 hours, Continuous)."
        },
        "cost": {
          "type": "number",
          "default": 0,
          "description": "Altın (gp) cinsinden piyasa değeri."
        },
        "weight": {
          "type": "number",
          "default": 0,
          "description": "Pound (lb) cinsinden ağırlık."
        },
        "material": {
          "type": ["string", "null"],
          "default": null,
          "description": "Özel materyal kimliği (örn: 'mat_mithral', 'mat_adamantine', 'mat_cold_iron', 'mat_alchemical_silver' veya null)."
        },
        "enhancementBonus": {
          "type": "integer",
          "default": 0,
          "description": "Silah veya zırhın temel büyüsel geliştirme bonusu (+1..+5)."
        },
        "enhancements": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Silah veya zırha eklenen özel yetenek kimlikleri (örn: ['enh_keen', 'enh_flaming'])."
        },
        "modifiers": {
          "type": "array",
          "description": "Varlığın sağladığı tüm sayısal veya formül tabanlı stat/zar etkileri.",
          "items": {
            "$ref": "#/definitions/ModifierEntryV2"
          },
          "default": []
        },
        "damageParts": {
          "type": "array",
          "description": "Silah, büyü veya manevranın yapısal hasar zarları dizisi.",
          "items": {
            "$ref": "#/definitions/DamagePartEntryV2"
          },
          "default": []
        },
        "modes": {
          "type": "array",
          "description": "Büyü, silah veya eşyanın gömülü alt modları / koşullu varyantları / ikincil güçleri.",
          "items": {
            "$ref": "#/definitions/ModeEntryV2"
          },
          "default": []
        },
        "weaponStats": {
          "type": ["object", "null"],
          "default": null,
          "description": "Yalnızca Weapon kategorisi için yapısal silah nitelikleri.",
          "properties": {
            "category": { "type": "string", "enum": ["Simple", "Martial", "Exotic"] },
            "handedness": { "type": "string", "enum": ["Unarmed", "Light", "One-Handed", "Two-Handed", "Ranged"] },
            "baseDamage": { "type": "string", "example": "1d8" },
            "critMin": { "type": "integer", "default": 20 },
            "critMult": { "type": "integer", "default": 2 },
            "damageTypes": { "type": "array", "items": { "type": "string" } },
            "rangeIncrement": { "type": "number", "default": 0 },
            "finessable": { "type": "boolean", "default": false },
            "isLight": { "type": "boolean", "default": false }
          }
        },
        "armorStats": {
          "type": ["object", "null"],
          "default": null,
          "description": "Yalnızca Armor veya Shield kategorisi için yapısal zırh nitelikleri.",
          "properties": {
            "category": { "type": "string", "enum": ["Light", "Medium", "Heavy", "Shield"] },
            "baseAc": { "type": "integer", "default": 0 },
            "maxDex": { "type": ["integer", "null"], "default": null },
            "acp": { "type": "integer", "default": 0 },
            "asf": { "type": "integer", "default": 0 },
            "speed30": { "type": "integer", "default": 30 },
            "speed20": { "type": "integer", "default": 20 }
          }
        },
        "spellStats": {
          "type": ["object", "null"],
          "default": null,
          "description": "Yalnızca Spell veya Maneuver kategorisi için yapısal büyü/manevra nitelikleri.",
          "properties": {
            "school": { "type": "string" },
            "discipline": { "type": "string" },
            "level": { "type": ["integer", "string"] },
            "components": { "type": "string" },
            "castingTime": { "type": "string" },
            "range": { "type": "string" },
            "targetOrArea": { "type": "string" },
            "duration": { "type": "string" },
            "savingThrow": { "type": "string" },
            "spellResistance": { "type": "string" }
          }
        },
        "range": {
          "type": "string",
          "description": "Menzil (Personal, Touch, Close [25 ft. + 5 ft./2 levels], Medium [100 ft. + 10 ft./level], Long [400 ft. + 40 ft./level])."
        },
        "school": {
          "type": "string",
          "description": "Büyü okulu (Abjuration, Conjuration, Divination, Enchantment, Evocation, Illusion, Necromancy, Transmutation, Universal)."
        },
        "level": {
          "type": ["integer", "string"],
          "description": "Büyü veya manevra seviyesi (0-9)."
        },
        "discipline": {
          "type": "string",
          "description": "Tome of Battle disiplini."
        },
        "isFighterBonusFeat": {
          "type": "boolean",
          "default": false,
          "description": "Savaşçı (Fighter) bonus hüneri olarak seçilip seçilemeyeceği (PHB Tablo 5-1)."
        },
        "featType": {
          "type": "string",
          "enum": ["General", "Item Creation", "Metamagic", "Special", "Tactical", "Fighter"],
          "default": "General"
        },
        "ruleFlags": {
          "type": "object",
          "default": {},
          "description": "Kural motoru deklaratif bayrakları (örn: {'ignoresHardness': true, 'touchAttack': true, 'keen': true, 'hasteExtraAttack': true})."
        },
        "tacticalBadges": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Arayüzde gösterilecek pasif/durumsal taktiksel rozetler (örn: ['Bypass DR/Hardness', 'Ranged Touch', 'Fortification 25%'])."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Katalog ve arama filtreleme etiketleri."
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "desc"],
            "properties": {
              "name": { "type": "string" },
              "desc": { "type": "string" }
            }
          }
        },
        "domains": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "canonicalExamples": [
    {
      "category": "Magic Item / Ring (Kanonik V2 Yüzük Örneği)",
      "payload": {
        "entries": [
          {
            "schemaVersion": 2,
            "id": "item_ring_of_protection_2",
