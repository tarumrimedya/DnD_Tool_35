{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuleMasterAiResponseSchemaV2",
  "description": "Canonical V2 JSON response schema (schemaVersion: 2) for D&D 3.5e Rule Master AI (Gemini) queries. All responses must be returned inside the 'entries' array. Legacy flat bonus columns (strBonus, acBonus, etc.) or separate child rows are forbidden; all mechanical effects must be defined inside 'modifiers', 'damageParts', and 'modes'.",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "description": "List of Canonical V2 objects for the queried D&D 3.5e rule, spell, feat, item, or entity.",
      "items": {
        "$ref": "#/definitions/RuleMasterEntryV2"
      }
    }
  },
  "definitions": {
    "ModifierEntryV2": {
      "type": "object",
      "required": ["target", "type"],
      "properties": {
        "target": {
          "type": "string",
          "description": "Target stat or mechanic key (e.g. 'ability.str', 'ability.dex', 'ability.con', 'ability.int', 'ability.wis', 'ability.cha', 'ac', 'ac.armor', 'ac.shield', 'ac.deflection', 'ac.natural', 'ac.dodge', 'attack.all', 'attack.melee', 'attack.ranged', 'damage.all', 'damage.melee', 'save.all', 'save.fort', 'save.ref', 'save.will', 'init', 'speed.land', 'hp', 'casterLevel', 'skill.all', 'skill.tumble')."
        },
        "value": {
          "type": "number",
          "description": "Static numeric bonus or penalty value."
        },
        "formula": {
          "type": "string",
          "description": "Dynamic scaling bonus formula (e.g. 'min(5, 2 + floor(casterLevel / 6))'). Used instead of static 'value'."
        },
        "type": {
          "type": "string",
          "enum": [
            "Enhancement",
            "Deflection",
            "Armor",
            "Shield",
            "Natural Armor",
            "Resistance",
            "Morale",
            "Luck",
            "Insight",
            "Sacred",
            "Profane",
            "Competence",
            "Circumstance",
            "Alchemical",
            "Racial",
            "Size",
            "Dodge",
            "Inherent",
            "Untyped",
            "Penalty"
          ],
          "default": "Untyped",
          "description": "Official D&D 3.5e bonus type (bonuses of the same type do not stack except Dodge, Circumstance, and Untyped)."
        },
        "condition": {
          "type": ["string", "null"],
          "default": null,
          "description": "Optional situational condition (e.g. 'vs evil', 'while charging', or null)."
        }
      }
    },
    "DamagePartEntryV2": {
      "type": "object",
      "required": ["dice", "type"],
      "properties": {
        "dice": {
          "type": "string",
          "description": "Damage or healing dice formula (e.g. '1d8', '2d6', 'min(10, casterLevel)d6'). Never include the 6-sided die emoji (U+1F3B2)."
        },
        "bonus": {
          "type": "number",
          "default": 0,
          "description": "Flat numeric damage bonus added to the dice."
        },
        "type": {
          "type": "string",
          "default": "Untyped",
          "description": "Damage type (Slashing, Piercing, Bludgeoning, Fire, Cold, Electricity, Acid, Sonic, Force, Positive Energy, Negative Energy, Holy, Unholy, Untyped / Divine Light)."
        },
        "multiplyOnCrit": {
          "type": "boolean",
          "default": false,
          "description": "Whether this dice expression multiplies on a critical hit (true for base weapon damage, false for bonus energy dice such as Flaming)."
        },
        "onCritOnly": {
          "type": "boolean",
          "default": false,
          "description": "Whether this extra dice triggers only on a confirmed critical hit (e.g. Flaming Burst +1d10)."
        },
        "source": {
          "type": "string",
          "description": "Origin of the damage part (e.g. 'Base Weapon', 'Flaming', 'Mountain Hammer')."
        }
      }
    },
    "ModeEntryV2": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique slug identifier for the mode (e.g. 'vs_undead', 'two_handed', 'sacrifice_4_hp')."
        },
        "name": {
          "type": "string",
          "description": "Short UI pill label for the mode (e.g. 'Undead (1d6/CL)', 'Two-Handed', 'Sacrifice 4 HP (+2d6)')."
        },
        "actionType": {
          "type": "string",
          "enum": ["passive", "standard", "move", "swift", "immediate", "full_round", "free"],
          "default": "standard"
        },
        "grip": {
          "type": "string",
          "enum": ["one_handed", "two_handed", "off_hand", "none"],
          "default": "none"
        },
        "isRanged": {
          "type": "boolean",
          "default": false
        },
        "range": {
          "type": "string"
        },
        "benefit": {
          "type": "string",
          "description": "Concise mechanical description of this sub-mode or secondary power."
        },
        "damageParts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DamagePartEntryV2"
          },
          "default": []
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModifierEntryV2"
          },
          "default": []
        },
        "save": {
          "type": ["string", "null"],
          "default": null
        }
      }
    },
    "RuleMasterEntryV2": {
      "type": "object",
      "required": ["schemaVersion", "id", "name", "type", "source", "benefit", "description", "modifiers", "damageParts", "modes"],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "enum": [2],
          "default": 2,
          "description": "Canonical V2 schema version (always 2)."
        },
        "id": {
          "type": "string",
          "description": "Immutable unique slug identifier (e.g. 'item_ring_of_protection_2', 'spell_searing_light', 'feat_power_attack').",
          "example": "item_ring_of_protection_2"
        },
        "baseItemId": {
          "type": ["string", "null"],
          "default": null,
          "description": "Base SRD item ID for composite weapons or armors (e.g. 'wpn_longsword', 'arm_mithral_shirt')."
        },
        "name": {
          "type": "string",
          "description": "Official D&D 3.5e English name of the entity. Sub-powers must be embedded inside 'modes', never as separate rows.",
          "example": "Ring of Protection +2"
        },
        "type": {
          "type": "string",
          "enum": [
            "Feat",
            "Spell",
            "Power",
            "Weapon",
            "Armor",
            "Shield",
            "Wondrous Item",
            "Ring",
            "Potion",
            "Scroll",
            "Wand",
            "Consumable",
            "Augment Crystal",
            "Maneuver",
            "Stance",
            "Race",
            "Deity",
            "Domain",
            "Template",
            "Class"
          ],
          "description": "Primary rule category of the entity."
        },
        "slot": {
          "type": "string",
          "enum": [
            "None",
            "Main Hand",
            "Off-Hand/Shield",
            "Two Hands",
            "Armor",
            "Head",
            "Face",
            "Throat",
            "Shoulders",
            "Body",
            "Torso",
            "Waist",
            "Feet",
            "Arms",
            "Hands",
            "Ring",
            "Belt"
          ],
          "default": "None",
          "description": "Equipment body slot ('None' for Feats, Spells, Races, Deities, Domains, Templates, and Classes)."
        },
        "role": {
          "type": "string",
          "enum": [
            "General",
            "Offense / Spell",
            "Offense / Strike",
            "Offense / Weapon",
            "Defense / Armor",
            "Defense / Shield",
            "Tactical / Stance",
            "Tactical / Boost"
          ],
          "default": "General",
          "description": "Tactical UI role of the card."
        },
        "source": {
          "type": "string",
          "description": "Official D&D 3.5e sourcebook name and page number.",
          "example": "Dungeon Master's Guide v.3.5, p. 232"
        },
        "benefit": {
          "type": "string",
          "description": "Concise mechanical summary and rule benefit in English."
        },
        "description": {
          "type": "string",
          "description": "Full official D&D 3.5e RAW rulebook text in English."
        },
        "prereq": {
          "type": "string",
          "default": "-",
          "description": "Official D&D 3.5e prerequisites for Feats, Maneuvers, or Prestige Classes."
        },
        "action": {
          "type": "string",
          "default": "Passive",
          "description": "Action economy cost (Standard Action, Move Action, Swift Action, Immediate Action, Free Action, Full-Round Action, Passive)."
        },
        "actionType": {
          "type": "string",
          "enum": ["passive", "standard", "move", "swift", "immediate", "full_round", "free"],
          "default": "passive",
          "description": "Normalized action type key for RuleEngine."
        },
        "duration": {
          "type": "string",
          "default": "Continuous",
          "description": "Effect duration (Instantaneous, 1 round/level, 10 min./level, 24 hours, Continuous)."
        },
        "cost": {
          "type": "number",
          "default": 0,
          "description": "Market price in gold pieces (gp)."
        },
        "weight": {
          "type": "number",
          "default": 0,
          "description": "Weight in pounds (lb)."
        },
        "material": {
          "type": ["string", "null"],
          "default": null,
          "description": "Special material identifier (e.g. 'mat_mithral', 'mat_adamantine', 'mat_cold_iron', 'mat_alchemical_silver', or null)."
        },
        "enhancementBonus": {
          "type": "integer",
          "default": 0,
          "description": "Base magical enhancement bonus (+1 to +5) for weapons, armor, or shields."
        },
        "enhancements": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Special ability identifiers applied to a weapon or armor (e.g. ['enh_keen', 'enh_flaming'])."
        },
        "requiresEnergyChoice": {
          "type": "boolean",
          "default": false,
          "description": "True if the spell or buff requires selecting an energy type on activation (e.g. Resist Energy, Protection from Energy)."
        },
        "dailyCharges": {
          "type": ["object", "null"],
          "default": null,
          "description": "Daily charge pool for MIC/DMG charged magic items (e.g. Belt of Battle).",
          "properties": {
            "max": { "type": "integer", "default": 3 },
            "recharge": { "type": "string", "default": "dawn" }
          }
        },
        "crystalTier": {
          "type": ["string", "null"],
          "enum": ["Least", "Lesser", "Greater", null],
          "default": null,
          "description": "MIC Augment Crystal tier."
        },
        "crystalSlot": {
          "type": ["string", "null"],
          "enum": ["Weapon", "Armor", "Shield", null],
          "default": null,
          "description": "MIC Augment Crystal attachment target."
        },
        "modifiers": {
          "type": "array",
          "description": "All numeric or formula-based stat and roll modifiers granted by this entry.",
          "items": {
            "$ref": "#/definitions/ModifierEntryV2"
          },
          "default": []
        },
        "damageParts": {
          "type": "array",
          "description": "Structured damage dice parts for weapons, spells, maneuvers, or crystals.",
          "items": {
            "$ref": "#/definitions/DamagePartEntryV2"
          },
          "default": []
        },
        "modes": {
          "type": "array",
          "description": "Embedded sub-modes, conditional variants, or secondary powers of the spell, weapon, or item.",
          "items": {
            "$ref": "#/definitions/ModeEntryV2"
          },
          "default": []
        },
        "weaponMeta": {
          "type": ["object", "null"],
          "default": null,
          "description": "Canonical V2 weapon metadata required for Weapon entries and proficiency checks.",
          "properties": {
            "proficiency": { "type": "string", "enum": ["Simple", "Martial", "Exotic"] },
            "handedness": { "type": "string", "enum": ["Unarmed", "Light", "One-Handed", "Two-Handed", "Ranged"] },
            "damageDice": { "type": "string", "example": "1d8" },
            "critMin": { "type": "integer", "default": 20 },
            "critMult": { "type": "integer", "default": 2 },
            "damageType": { "type": "string", "example": "Slashing" },
            "rangeIncrement": { "type": "number", "default": 0 },
            "isDoubleWeapon": { "type": "boolean", "default": false },
            "isFinessable": { "type": "boolean", "default": false }
          }
        },
        "armorMeta": {
          "type": ["object", "null"],
          "default": null,
          "description": "Canonical V2 armor/shield metadata required for Armor or Shield entries and proficiency checks.",
          "properties": {
            "category": { "type": "string", "enum": ["Light", "Medium", "Heavy", "Shield"] },
            "armorBonus": { "type": "integer", "default": 0 },
            "maxDex": { "type": ["integer", "null"], "default": null },
            "acp": { "type": "integer", "default": 0 },
            "asf": { "type": "integer", "default": 0 },
            "speed30": { "type": "integer", "default": 30 },
            "speed20": { "type": "integer", "default": 20 }
          }
        },
        "weaponStats": {
          "type": ["object", "null"],
          "default": null,
          "description": "Structured weapon attributes for Weapon category entries.",
          "properties": {
            "category": { "type": "string", "enum": ["Simple", "Martial", "Exotic"] },
            "handedness": { "type": "string", "enum": ["Unarmed", "Light", "One-Handed", "Two-Handed", "Ranged"] },
            "baseDamage": { "type": "string", "example": "1d8" },
            "critMin": { "type": "integer", "default": 20 },
            "critMult": { "type": "integer", "default": 2 },
            "damageTypes": { "type": "array", "items": { "type": "string" } },
            "rangeIncrement": { "type": "number", "default": 0 },
            "finessable": { "type": "boolean", "default": false },
            "isLight": { "type": "boolean", "default": false }
          }
        },
        "armorStats": {
          "type": ["object", "null"],
          "default": null,
          "description": "Structured armor attributes for Armor or Shield category entries.",
          "properties": {
            "category": { "type": "string", "enum": ["Light", "Medium", "Heavy", "Shield"] },
            "baseAc": { "type": "integer", "default": 0 },
            "maxDex": { "type": ["integer", "null"], "default": null },
            "acp": { "type": "integer", "default": 0 },
            "asf": { "type": "integer", "default": 0 },
            "speed30": { "type": "integer", "default": 30 },
            "speed20": { "type": "integer", "default": 20 }
          }
        },
        "spellStats": {
          "type": ["object", "null"],
          "default": null,
          "description": "Structured spell or maneuver attributes.",
          "properties": {
            "school": { "type": "string" },
            "discipline": { "type": "string" },
            "level": { "type": ["integer", "string"] },
            "components": { "type": "string" },
            "castingTime": { "type": "string" },
            "range": { "type": "string" },
            "targetOrArea": { "type": "string" },
            "duration": { "type": "string" },
            "savingThrow": { "type": "string" },
            "spellResistance": { "type": "string" }
          }
        },
        "range": {
          "type": "string",
          "description": "Spell, maneuver, or weapon range (Personal, Touch, Close [25 ft. + 5 ft./2 levels], Medium [100 ft. + 10 ft./level], Long [400 ft. + 40 ft./level])."
        },
        "school": {
          "type": "string",
          "description": "Spell school (Abjuration, Conjuration, Divination, Enchantment, Evocation, Illusion, Necromancy, Transmutation, Universal)."
        },
        "level": {
          "type": ["integer", "string"],
          "description": "Spell, power, or maneuver level (0-9)."
        },
        "discipline": {
          "type": "string",
          "description": "Tome of Battle Sublime Way discipline."
        },
        "isFighterBonusFeat": {
          "type": "boolean",
          "default": false,
          "description": "Whether this feat can be selected as a Fighter bonus feat (PHB Table 5-1)."
        },
        "featType": {
          "type": "string",
          "enum": ["General", "Item Creation", "Metamagic", "Special", "Tactical", "Fighter", "Divine", "Reserve", "Psionic", "Epic"],
          "default": "General"
        },
        "ruleFlags": {
          "type": "object",
          "default": {},
          "description": "Declarative RuleEngine flags (e.g. {'conToWillSave': true, 'noAutoFailFortSaveOnNat1': true, 'agileShieldFighter': true, 'ignoresHardness': true, 'touchAttack': true, 'keen': true, 'hasteExtraAttack': true, 'powerAttackBonusDamage': 2, 'powerAttackMinPenalty': 2, 'concealment': 20, 'sr': 21, 'dr': '3/-', 'energyResistance': '10', 'darkvisionFt': 60})."
        },
        "tacticalBadges": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Passive or situational tactical badges rendered on UI cards (e.g. ['Bypass DR/Hardness', 'Ranged Touch', 'Fortification 25%'])."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Search and catalog filter tags."
        },
        "size": {
          "type": ["string", "null"],
          "default": null,
          "description": "Creature size category for Race entries (Fine, Diminutive, Tiny, Small, Medium, Large, Huge, Gargantuan, Colossal)."
        },
        "baseSpeed": {
          "type": ["number", "null"],
          "default": null,
          "description": "Base land speed in feet for Race entries."
        },
        "vision": {
          "type": ["string", "null"],
          "default": null,
          "description": "Racial vision trait (Normal, Low-Light Vision, Darkvision 60 ft., Darkvision 120 ft.)."
        },
        "favoredClass": {
          "type": ["string", "null"],
          "default": null,
          "description": "Favored class for Race entries (e.g. 'Any', 'Fighter', 'Wizard')."
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "desc"],
            "properties": {
              "name": { "type": "string" },
              "desc": { "type": "string" }
            }
          }
        },
        "alignment": {
          "type": ["string", "null"],
          "default": null,
          "description": "Deity alignment code (LG, NG, CG, LN, N, CN, LE, NE, CE)."
        },
        "favoredWeapon": {
          "type": ["string", "null"],
          "default": null,
          "description": "Deity favored weapon name."
        },
        "domains": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Cleric domains granted by a Deity."
        },
        "grantedPower": {
          "type": ["string", "null"],
          "default": null,
          "description": "Official granted power text for a Cleric Domain."
        },
        "domainSpells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "name"],
            "properties": {
              "level": { "type": "integer" },
              "id": { "type": "string" },
              "name": { "type": "string" }
            }
          },
          "description": "Levels 1-9 spell list for a Cleric Domain."
        },
        "levelAdjustment": {
          "type": ["integer", "null"],
          "default": null,
          "description": "Level Adjustment (LA) for Race or Template entries."
        },
        "crAdjustment": {
          "type": ["integer", "null"],
          "default": null,
          "description": "Challenge Rating (CR) adjustment for Template entries."
        }
      }
    }
  },
  "canonicalExamples": [
    {
      "category": "Magic Item / Ring (Canonical V2 Ring Example)",
      "payload": {
        "entries": [
          {
            "schemaVersion": 2,
            "id": "item_ring_of_protection_2",
