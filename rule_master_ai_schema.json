{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuleMasterAiResponseSchemaV2",
  "description": "Canonical V2 JSON response schema (schemaVersion: 2) for D&D 3.5e Rule Master AI (Gemini) queries. All responses must be returned inside the 'entries' array. Legacy flat bonus columns (strBonus, acBonus, etc.) or separate child rows are forbidden; all mechanical effects must be defined inside 'modifiers', 'damageParts', and 'modes'.",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "description": "List of Canonical V2 objects for the queried D&D 3.5e rule, spell, feat, item, or entity.",
      "items": {
        "$ref": "#/definitions/RuleMasterEntryV2"
      }
    }
  },
  "definitions": {
    "ModifierEntryV2": {
      "type": "object",
      "required": ["target", "type"],
      "properties": {
        "target": {
          "type": "string",
          "description": "Target stat or mechanic key (e.g. 'ability.str', 'ability.dex', 'ability.con', 'ability.int', 'ability.wis', 'ability.cha', 'ac', 'ac.armor', 'ac.shield', 'ac.deflection', 'ac.natural', 'ac.dodge', 'attack.all', 'attack.melee', 'attack.ranged', 'damage.all', 'damage.melee', 'save.all', 'save.fort', 'save.ref', 'save.will', 'init', 'speed.land', 'hp', 'casterLevel', 'skill.all', 'skill.tumble')."
        },
        "value": {
          "type": "number",
          "description": "Static numeric bonus or penalty value."
        },
        "formula": {
          "type": "string",
          "description": "Dynamic scaling bonus formula (e.g. 'min(5, 2 + floor(casterLevel / 6))'). Used instead of static 'value'."
        },
        "type": {
          "type": "string",
          "enum": [
            "Enhancement",
            "Deflection",
            "Armor",
            "Shield",
            "Natural Armor",
            "Resistance",
            "Morale",
            "Luck",
            "Insight",
            "Sacred",
            "Profane",
            "Competence",
            "Circumstance",
            "Alchemical",
            "Racial",
            "Size",
            "Dodge",
            "Inherent",
            "Untyped",
            "Penalty"
          ],
          "default": "Untyped",
          "description": "Official D&D 3.5e bonus type (bonuses of the same type do not stack except Dodge, Circumstance, and Untyped)."
        },
        "condition": {
          "type": ["string", "null"],
          "default": null,
          "description": "Optional situational condition (e.g. 'vs evil', 'while charging', or null)."
        },
        "op": {
          "type": "string",
          "enum": ["add", "set", "max", "min", "replace", "multiply", "step_die"],
          "default": "add",
          "description": "Lego operation: 'add' (default), 'set', 'max' (may use X instead of Y), 'min', 'replace' (uses X instead of Y), 'multiply' (RAW multiplier), or 'step_die' (increase/decrease weapon damage die step)."
        },
        "selector": {
          "type": ["object", "null"],
          "default": null,
          "description": "Entity/component filter when target modifies another ability, spell, or weapon (e.g. {'id': 'boon_absorb_magic'}, {'type': 'Spell', 'maxLevel': 3, 'school': 'Evocation'}, {'type': 'Weapon', 'tag': 'crafted_by_self'}).",
          "properties": {
            "id": { "type": "string" },
            "type": { "type": "string" },
            "school": { "type": "string" },
            "maxLevel": { "type": "integer" },
            "minLevel": { "type": "integer" },
            "tag": { "type": "string" },
            "mode": { "type": "string" }
          }
        },
        "cap": {
          "type": ["number", "string", "null"],
          "default": null,
          "description": "Optional maximum cap value or formula (e.g. '@classes.duelist.level' for Canny Defense)."
        },
        "appliesTo": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Sub-scopes for scoped modifiers such as Powerful Build (e.g. ['grapple', 'bullRush', 'trip', 'overrun', 'sunder', 'weaponSize', 'opposedSize'])."
        },
        "affects": {
          "type": "array",
          "items": { "type": "string", "enum": ["normal", "touch", "flatFooted"] },
          "description": "Which AC variants a base/total AC replacement affects."
        },
        "sourceLabel": {
          "type": ["string", "null"],
          "default": null,
          "description": "Sub-feature origin label for multi-benefit Boons (e.g. 'Benefit 1', 'Benefit 2')."
        },
        "when": {
          "type": ["object", "null"],
          "default": null,
          "description": "Structured predicate condition ({ toggle, equipped, has, vs, terrain, armorCategory, all, any, not })."
        }
      }
    },
    "DefenseEntryV2": {
      "type": "object",
      "required": ["kind", "target"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["dr", "sr", "resistance", "immunity", "vulnerability", "regen", "fast_healing", "fortification", "absorption"],
          "description": "Defense primitive type."
        },
        "target": {
          "type": "string",
          "description": "Damage, energy, or effect type (e.g. 'acid', 'fire', 'cold', 'electricity', 'sonic', 'magic', 'all', 'crit', 'mind_affecting', 'fear', 'sleep', 'paralysis', 'stun', 'slow', 'poison', 'disease')."
        },
        "value": {
          "type": "number",
          "description": "Static numeric value (e.g. 10 for Acid Resist 10, 25 for Fortification 25%)."
        },
        "formula": {
          "type": "string",
          "description": "Dynamic scaling formula (e.g. '@level * 2', '21 + @level', '@chaMod')."
        },
        "bypass": {
          "type": ["string", "null"],
          "default": null,
          "description": "DR or Regen bypass type (e.g. '-', 'magic', 'adamantine', 'cold_iron', 'acid_or_fire')."
        },
        "healRatio": {
          "type": "number",
          "default": 1,
          "description": "For kind='absorption', ratio of absorbed energy damage converted into healing (e.g. 1.0 for Elemental Supremacy, 0.33 for Iron Golem)."
        },
        "sourceLabel": {
          "type": ["string", "null"],
          "default": null
        },
        "when": {
          "type": ["object", "null"],
          "default": null
        }
      }
    },
    "ResourceEntryV2": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["consume", "allocate"],
          "default": "consume",
          "description": "'consume' for daily/hourly/cooldown charges; 'allocate' for reusable investment pools such as Incarnum Essentia."
        },
        "maxFormula": {
          "type": ["string", "number"],
          "default": 1,
          "description": "Maximum pool capacity or formula (e.g. 1, 3, '1 + @wisMod', 'floor(@level / 3)')."
        },
        "recharge": {
          "type": "object",
          "properties": {
            "period": {
              "type": "string",
              "enum": ["at_will", "day", "hour", "encounter", "rounds", "rest"],
              "default": "day"
            },
            "dice": {
              "type": ["string", "null"],
              "default": null,
              "description": "Rollable round cooldown expression when period='rounds' (e.g. '1d4+1')."
            }
          }
        }
      }
    },
    "GrantEntryV2": {
      "type": "object",
      "required": ["grantType"],
      "properties": {
        "grantType": {
          "type": "string",
          "enum": ["entity", "spell_at_will", "proficiency", "metamagic", "sense", "movement"],
          "description": "Type of automatic grant or synergy unlock."
        },
        "targetId": {
          "type": ["string", "null"],
          "default": null,
          "description": "Granted entity ID, sense ID (e.g. 'blindsense_30', 'blindsight_120', 'scent_30', 'darkvision_60'), or proficiency group."
        },
        "value": {
          "type": ["number", "string", "null"],
          "default": null
        },
        "filter": {
          "type": ["object", "null"],
          "default": null,
          "description": "Filter for spell_at_will or metamagic grants (e.g. {'school': 'Abjuration', 'level': 1})."
        },
        "requires": {
          "type": ["object", "null"],
          "default": null,
          "description": "Synergy prerequisite predicate (e.g. {'all': ['boon_absorb_magic', 'boon_elemental_accustomed']})."
        },
        "sourceLabel": {
          "type": ["string", "null"],
          "default": null
        }
      }
    },
    "ChoiceEntryV2": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "pickCount": { "type": "integer", "default": 1 },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "bindsTo": {
          "type": "string",
          "description": "Variable token bound by this selection (e.g. '$chosenEnergy', '$chosenSchool', '$chosenWeapon')."
        }
      }
    },
    "DamagePartEntryV2": {
      "type": "object",
      "required": ["dice", "type"],
      "properties": {
        "dice": {
          "type": "string",
          "description": "Damage or healing dice formula (e.g. '1d8', '2d6', 'min(10, casterLevel)d6'). Never include the 6-sided die emoji (U+1F3B2)."
        },
        "bonus": {
          "type": "number",
          "default": 0,
          "description": "Flat numeric damage bonus added to the dice."
        },
        "type": {
          "type": "string",
          "default": "Untyped",
          "description": "Damage type (Slashing, Piercing, Bludgeoning, Fire, Cold, Electricity, Acid, Sonic, Force, Positive Energy, Negative Energy, Holy, Unholy, Untyped / Divine Light)."
        },
        "multiplyOnCrit": {
          "type": "boolean",
          "default": false,
          "description": "Whether this dice expression multiplies on a critical hit (true for base weapon damage, false for bonus energy dice such as Flaming)."
        },
        "onCritOnly": {
          "type": "boolean",
          "default": false,
          "description": "Whether this extra dice triggers only on a confirmed critical hit (e.g. Flaming Burst +1d10)."
        },
        "source": {
          "type": "string",
          "description": "Origin of the damage part (e.g. 'Base Weapon', 'Flaming', 'Mountain Hammer')."
        }
      }
    },
    "ModeEntryV2": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique slug identifier for the mode (e.g. 'vs_undead', 'two_handed', 'sacrifice_4_hp')."
        },
        "name": {
          "type": "string",
          "description": "Short UI pill label for the mode (e.g. 'Undead (1d6/CL)', 'Two-Handed', 'Sacrifice 4 HP (+2d6)')."
        },
        "actionType": {
          "type": "string",
          "enum": ["passive", "standard", "move", "swift", "immediate", "full_round", "free"],
          "default": "standard"
        },
        "grip": {
          "type": "string",
          "enum": ["one_handed", "two_handed", "off_hand", "none"],
          "default": "none"
        },
        "isRanged": {
          "type": "boolean",
          "default": false
        },
        "range": {
          "type": "string"
        },
        "benefit": {
          "type": "string",
          "description": "Concise mechanical description of this sub-mode or secondary power."
        },
        "damageParts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DamagePartEntryV2"
          },
          "default": []
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModifierEntryV2"
          },
          "default": []
        },
        "save": {
          "type": ["string", "object", "null"],
          "default": null,
          "description": "Saving throw descriptor string or structured object ({ type: 'Reflex'|'Fortitude'|'Will', dcFormula: '10 + @level + @conMod', onSave: 'half'|'negate'|'partial' })."
        },
        "sourceLabel": {
          "type": ["string", "null"],
          "default": null,
          "description": "Origin sub-label for multi-benefit Boons or paths (e.g. 'Benefit 1', 'Benefit 2')."
        },
        "reactsTo": {
          "type": ["string", "null"],
          "enum": ["save_failed", "on_spell_targeted", "on_hit", "on_kill", "on_damaged", "on_crit_received", "initiative", "turn_start", null],
          "default": null,
          "description": "UI reaction placement hint so reactive buttons render next to Saves, HP, or Attack panels."
        },
        "resourceCost": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "resourceId": { "type": "string" },
              "amount": { "type": ["number", "string"], "default": 1 },
              "level": { "type": ["number", "string", "null"], "default": null }
            }
          },
          "default": []
        },
        "inputs": {
          "type": "array",
          "description": "Runtime user inputs required when activating this mode (referenced in formulas as @input.<id>).",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "type": { "type": "string", "enum": ["int", "slider", "select"], "default": "int" },
              "min": { "type": ["number", "string"], "default": 0 },
              "max": { "type": ["number", "string"], "default": 9 },
              "default": { "type": ["number", "string"], "default": 1 }
            }
          },
          "default": []
        },
        "area": {
          "type": ["string", "null"],
          "default": null,
          "description": "Area of effect shape and size (e.g. '60 ft. line', '30 ft. cone', '@level * 5 ft. radius')."
        },
        "defenses": {
          "type": "array",
          "items": { "$ref": "#/definitions/DefenseEntryV2" },
          "default": []
        },
        "spawnsBuff": {
          "type": ["object", "null"],
          "default": null,
          "description": "Active buff, temporary HP, or round countdown timer spawned when this mode is triggered.",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "durationRounds": { "type": ["number", "string"], "default": 1 },
            "maxStacks": { "type": ["number", "null"], "default": null },
            "tempHpFormula": { "type": ["string", "number", "null"], "default": null },
            "healFormula": { "type": ["string", "number", "null"], "default": null },
            "modifiers": {
              "type": "array",
              "items": { "$ref": "#/definitions/ModifierEntryV2" },
              "default": []
            },
            "defenses": {
              "type": "array",
              "items": { "$ref": "#/definitions/DefenseEntryV2" },
              "default": []
            },
            "note": { "type": ["string", "null"], "default": null }
          }
        },
        "requires": {
          "type": ["object", "null"],
          "default": null
        },
        "when": {
          "type": ["object", "null"],
          "default": null
        }
      }
    },
    "RuleMasterEntryV2": {
      "type": "object",
      "required": ["schemaVersion", "id", "name", "type", "source", "benefit", "description", "modifiers", "damageParts", "modes"],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "enum": [2],
          "default": 2,
          "description": "Canonical V2 schema version (always 2)."
        },
        "id": {
          "type": "string",
          "description": "Immutable unique slug identifier (e.g. 'item_ring_of_protection_2', 'spell_searing_light', 'feat_power_attack').",
          "example": "item_ring_of_protection_2"
        },
        "baseItemId": {
          "type": ["string", "null"],
          "default": null,
          "description": "Base SRD item ID for composite weapons or armors (e.g. 'wpn_longsword', 'arm_mithral_shirt')."
        },
        "name": {
          "type": "string",
          "description": "Official D&D 3.5e English name of the entity. Sub-powers must be embedded inside 'modes', never as separate rows.",
          "example": "Ring of Protection +2"
        },
        "type": {
          "type": "string",
          "enum": [
            "Feat",
            "Spell",
            "Power",
            "Weapon",
            "Armor",
            "Shield",
            "Wondrous Item",
            "Ring",
            "Potion",
            "Scroll",
            "Wand",
            "Consumable",
            "Augment Crystal",
            "Maneuver",
            "Stance",
            "Race",
            "Deity",
            "Domain",
            "Template",
            "Class",
            "Special Ability",
            "Racial Trait",
            "Class Feature",
            "DM Boon",
            "Flaw",
            "Trait",
            "Skill Trick"
          ],
          "description": "Primary rule category of the entity. Flaw = Unearthed Arcana character flaw (grants a bonus feat); Trait = Unearthed Arcana character trait (benefit + drawback); Skill Trick = Complete Scoundrel skill trick (bought with skill points)."
        },
        "slot": {
          "type": "string",
          "enum": [
            "None",
            "Main Hand",
            "Off-Hand/Shield",
            "Two Hands",
            "Armor",
            "Head",
            "Face",
            "Throat",
            "Shoulders",
            "Body",
            "Torso",
            "Waist",
            "Feet",
            "Arms",
            "Hands",
            "Ring",
            "Belt"
          ],
          "default": "None",
          "description": "Equipment body slot ('None' for Feats, Spells, Races, Deities, Domains, Templates, and Classes)."
        },
        "role": {
          "type": "string",
          "enum": [
            "General",
            "Offense / Spell",
            "Offense / Strike",
            "Offense / Weapon",
            "Defense / Armor",
            "Defense / Shield",
            "Tactical / Stance",
            "Tactical / Boost"
          ],
          "default": "General",
          "description": "Tactical UI role of the card."
        },
        "source": {
          "type": "string",
          "description": "Official D&D 3.5e sourcebook name and page number.",
          "example": "Dungeon Master's Guide v.3.5, p. 232"
        },
        "benefit": {
          "type": "string",
          "description": "Concise mechanical summary and rule benefit in English."
        },
        "description": {
          "type": "string",
          "description": "Full official D&D 3.5e RAW rulebook text in English."
        },
        "prereq": {
          "type": "string",
          "default": "-",
          "description": "Official D&D 3.5e prerequisites for Feats, Maneuvers, or Prestige Classes."
        },
        "action": {
          "type": "string",
          "default": "Passive",
          "description": "Action economy cost (Standard Action, Move Action, Swift Action, Immediate Action, Free Action, Full-Round Action, Passive)."
        },
        "actionType": {
          "type": "string",
          "enum": ["passive", "standard", "move", "swift", "immediate", "full_round", "free"],
          "default": "passive",
          "description": "Normalized action type key for RuleEngine."
        },
        "duration": {
          "type": "string",
          "default": "Continuous",
          "description": "Effect duration (Instantaneous, 1 round/level, 10 min./level, 24 hours, Continuous)."
        },
        "cost": {
          "type": "number",
          "default": 0,
          "description": "Market price in gold pieces (gp)."
        },
        "weight": {
          "type": "number",
          "default": 0,
          "description": "Weight in pounds (lb)."
        },
        "material": {
          "type": ["string", "null"],
          "default": null,
          "description": "Special material identifier (e.g. 'mat_mithral', 'mat_adamantine', 'mat_cold_iron', 'mat_alchemical_silver', or null)."
        },
        "enhancementBonus": {
          "type": "integer",
          "default": 0,
          "description": "Base magical enhancement bonus (+1 to +5) for weapons, armor, or shields."
        },
        "enhancements": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Special ability identifiers applied to a weapon or armor (e.g. ['enh_keen', 'enh_flaming'])."
        },
        "requiresEnergyChoice": {
          "type": "boolean",
          "default": false,
          "description": "True if the spell or buff requires selecting an energy type on activation (e.g. Resist Energy, Protection from Energy)."
        },
        "dailyCharges": {
          "type": ["object", "null"],
          "default": null,
          "description": "Daily charge pool for MIC/DMG charged magic items (e.g. Belt of Battle).",
          "properties": {
            "max": { "type": "integer", "default": 3 },
            "recharge": { "type": "string", "default": "dawn" }
          }
        },
        "crystalTier": {
          "type": ["string", "null"],
          "enum": ["Least", "Lesser", "Greater", null],
          "default": null,
          "description": "MIC Augment Crystal tier."
        },
        "crystalSlot": {
          "type": ["string", "null"],
          "enum": ["Weapon", "Armor", "Shield", null],
          "default": null,
          "description": "MIC Augment Crystal attachment target."
        },
        "modifiers": {
          "type": "array",
          "description": "All numeric or formula-based stat and roll modifiers granted by this entry.",
          "items": {
            "$ref": "#/definitions/ModifierEntryV2"
          },
          "default": []
        },
        "damageParts": {
          "type": "array",
          "description": "Structured damage dice parts for weapons, spells, maneuvers, or crystals.",
          "items": {
            "$ref": "#/definitions/DamagePartEntryV2"
          },
          "default": []
        },
        "modes": {
          "type": "array",
          "description": "Embedded sub-modes, conditional variants, or secondary powers of the spell, weapon, or item.",
          "items": {
            "$ref": "#/definitions/ModeEntryV2"
          },
          "default": []
        },
        "defenses": {
          "type": "array",
          "description": "Structured V2.5 defense primitives (DR, SR, Energy Resistance, Immunity, Vulnerability, Regeneration, Fast Healing, Fortification, Absorption).",
          "items": {
            "$ref": "#/definitions/DefenseEntryV2"
          },
          "default": []
        },
        "resources": {
          "type": "array",
          "description": "Structured V2.5 consumable or allocatable resource pools and cooldowns.",
          "items": {
            "$ref": "#/definitions/ResourceEntryV2"
          },
          "default": []
        },
        "grants": {
          "type": "array",
          "description": "Structured V2.5 synergy unlocks, automatic grants, at-will spells, senses, or proficiencies.",
          "items": {
            "$ref": "#/definitions/GrantEntryV2"
          },
          "default": []
        },
        "choices": {
          "type": "array",
          "description": "Structured V2.5 permanent character build choices.",
          "items": {
            "$ref": "#/definitions/ChoiceEntryV2"
          },
          "default": []
        },
        "requires": {
          "type": ["object", "null"],
          "default": null,
          "description": "Structured V2.5 prerequisite predicate ({ all, any, minLevel, minBab, minAbility, has }) for deterministic HUB/Character eligibility filtering."
        },
        "overrides": {
          "type": ["string", "null"],
          "default": null,
          "description": "Optional target entity ID that this house-rule/DM pack entry overrides (e.g. 'srd:feat_power_attack')."
        },
        "pack": {
          "type": ["object", "null"],
          "default": null,
          "description": "DM Campaign Rule Pack namespace and version metadata.",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "author": { "type": "string" },
            "version": { "type": "string", "default": "1.0.0" }
          }
        },
        "weaponMeta": {
          "type": ["object", "null"],
          "default": null,
          "description": "Canonical V2 weapon metadata required for Weapon entries and proficiency checks.",
          "properties": {
            "proficiency": { "type": "string", "enum": ["Simple", "Martial", "Exotic"] },
            "handedness": { "type": "string", "enum": ["Unarmed", "Light", "One-Handed", "Two-Handed", "Ranged"] },
            "damageDice": { "type": "string", "example": "1d8" },
            "critMin": { "type": "integer", "default": 20 },
            "critMult": { "type": "integer", "default": 2 },
            "damageType": { "type": "string", "example": "Slashing" },
            "rangeIncrement": { "type": "number", "default": 0 },
