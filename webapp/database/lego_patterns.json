    {
      "patternId": "pat_reactive_save_counter_temp_hp",
      "name": "Reactive Save Booster & Temp HP Power (Absorb Magic)",
      "keywords": [
        "absorb magic",
        "immediate",
        "temp hp",
        "spell level",
        "dispelled",
        "save vs a spell"
      ],
      "template": {
        "schemaVersion": 3,
        "id": "boon_absorb_magic",
        "blueprint": "feat",
        "featKind": "feat",
        "name": "Absorb Magic",
        "type": "Homebrew",
        "source": "DM Draconic Defence Path",
        "tags": [
          "draconic",
          "absorb_magic"
        ],
        "facets": [
          "identity",
          "effects",
          "powers"
        ],
        "text": "Gain a +2 competence bonus on saving throws against a spell that targets you. If you save, gain 10 temporary hit points per spell level until the end of your next turn.",
        "effects": [
          {
            "type": "when",
            "flow": "while",
            "branches": [
              {
                "condKind": "state",
                "condText": "toggle:vs_targeted_spell",
                "effects": [
                  {
                    "type": "stat",
                    "targets": [
                      "save.all"
                    ],
                    "btype": "Competence",
                    "mode": "flat",
                    "value": 2
                  }
                ]
              }
            ],
            "label": "vs. Targeted Spell"
          },
          {
            "type": "resource",
            "name": "Absorbed Spell Level",
            "varKey": "absorbed_spell_level",
            "resMode": "dial",
            "maxMode": "flat",
            "max": 9,
            "reset": "atWill"
          }
        ],
        "powers": [
          {
            "id": "pw-absorb-on-save",
            "kind": "inline",
            "name": "Absorb Spell (Gain Temp HP)",
            "action": "Immediate",
            "usage": {
              "mode": "atwill"
            },
            "duration": "Until end of your next turn",
            "effects": [
              {
                "type": "roll",
                "kind": "Temp HP",
                "count": 0,
                "die": "flat",
                "flat": 0,
                "scaling": "formula",
                "dice": "10 * @absorbed_spell_level"
              }
            ],
            "text": "Triggered when you succeed on a save against a targeted spell; set @absorbed_spell_level to that spell's level."
          }
        ]
      }
