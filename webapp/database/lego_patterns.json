    {
      "patternId": "pat_synergy_mutator_unlock",
      "name": "Synergy Upgrade via Bonus-Type Stacking (Arcane Shield)",
      "keywords": [
        "synergy",
        "instead of",
        "competence bonus is now",
        "arcane shield",
        "when saved with"
      ],
      "template": {
        "schemaVersion": 3,
        "id": "boon_arcane_shield",
        "blueprint": "feat",
        "featKind": "feat",
        "name": "Arcane Shield",
        "type": "Homebrew",
        "source": "DM Draconic Synergy (Absorb Magic + Elemental Accustomed)",
        "tags": [
          "draconic",
          "synergy"
        ],
        "text": "Requires Absorb Magic and Elemental Accustomed. Absorb Magic's competence bonus becomes +4 (same-type Competence bonuses do not stack, so the higher +4 wins instead of mutating the other entry). When you save with Absorb Magic, gain Improved Evasion, Mettle, and a sacred bonus to AC equal to the absorbed spell level until the end of your next turn.",
        "effects": [
          {
            "type": "when",
            "flow": "while",
            "branches": [
              {
                "condKind": "state",
                "condText": "toggle:vs_targeted_spell",
                "effects": [
                  {
                    "type": "stat",
                    "targets": [
                      "save.all"
                    ],
                    "btype": "Competence",
                    "mode": "flat",
                    "value": 4
                  }
                ]
              }
            ],
            "label": "vs. Targeted Spell"
          },
          {
            "type": "when",
            "flow": "while",
            "branches": [
              {
                "condKind": "state",
                "condText": "toggle:absorbed_magic_eont",
                "effects": [
                  {
                    "type": "stat",
                    "targets": [
                      "ac.total"
                    ],
                    "btype": "Sacred",
                    "mode": "formula",
                    "value": 0,
                    "formula": "@absorbed_spell_level"
                  },
                  {
                    "type": "defense",
                    "mode": "Sense / Movement",
                    "what": "Improved Evasion"
                  },
                  {
                    "type": "defense",
                    "mode": "Sense / Movement",
                    "what": "Mettle"
                  }
                ]
              }
            ],
            "label": "Absorbed Magic (EONT)"
          }
        ]
      }
    },
