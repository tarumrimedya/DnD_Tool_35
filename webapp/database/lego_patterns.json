        "blueprint": "feat",
        "featKind": "feat",
        "name": "Draconic Acid Resistance",
        "type": "Homebrew",
        "source": "DM Draconic Boon",
        "tags": [
          "draconic",
          "acid"
        ],
        "text": "Your draconic blood grants acid resistance 10, increasing to 20 at 7th level and 30 at 11th level (Resist Energy breakpoints). Breakpoints use first-match `when` branches; the final `else` branch is the floor.",
        "effects": [
          {
            "type": "when",
            "flow": "if",
            "branches": [
              {
                "condKind": "levelTier",
                "condText": "@level >= 11",
                "effects": [
                  {
                    "type": "defense",
                    "mode": "Energy Resistance",
                    "what": "Acid",
                    "value": 30
                  }
                ]
              },
              {
                "condKind": "levelTier",
                "condText": "@level >= 7",
                "effects": [
                  {
                    "type": "defense",
                    "mode": "Energy Resistance",
                    "what": "Acid",
                    "value": 20
                  }
                ]
              },
              {
                "condKind": "else",
                "condText": "",
                "effects": [
                  {
                    "type": "defense",
                    "mode": "Energy Resistance",
                    "what": "Acid",
                    "value": 10
                  }
                ]
              }
            ]
          }
        ]
      }
