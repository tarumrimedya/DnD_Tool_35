      "name": "Draconic Core (1 hr/day)",
      "type": "DM Boon",
      "source": "DM Boon Sheet (A41)",
      "benefit": "1 hour/day: Gain Acid Immunity and deal 2x Breath Weapon damage.",
      "description": "Once per day for 1 hour, you gain full immunity to Acid and your Breath Weapon deals double damage (x2).",
      "action": "Standard Action",
      "actionType": "standard",
      "modifiers": [
        {
          "target": "entity.damageMultiplier",
          "selector": { "tag": "breath_weapon" },
          "op": "multiply",
          "value": 2,
          "when": { "toggle": "draconic_core_active" }
        }
      ],
      "defenses": [
        { "kind": "immunity", "target": "acid", "when": { "toggle": "draconic_core_active" } }
      ],
      "resources": [
