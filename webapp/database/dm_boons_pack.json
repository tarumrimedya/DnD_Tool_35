      "id": "pack_dm_draconic_boons:boon_arcane_shield",
      "name": "Arcane Shield (Synergy: Absorb Magic + Elemental Accustomed)",
      "type": "DM Boon",
      "source": "DM Draconic Defence Synergy (A92)",
      "benefit": "Synergy Unlock: Upgrades Absorb Magic save bonus from +2 to +4 Competence. When saved with Absorb Magic, gain Improved Evasion, Mettle, and +Sacred AC per spell level (EONT).",
      "description": "Requires Absorb Magic + Elemental Accustomed. When saved with Absorb Magic, gain Improved Evasion, Mettle, and +AC (Sacred) for each spell level dispelled this way (EONT). Absorb Magic's competence bonus becomes +4 instead of +2.",
      "action": "Passive",
      "actionType": "passive",
      "requires": {
        "all": ["boon_absorb_magic", "boon_elemental_accustomed"]
      },
      "modifiers": [
        {
          "target": "entity.saveBonus",
          "selector": { "id": "boon_absorb_magic" },
          "op": "set",
          "value": 4,
          "type": "Competence"
        }
      ],
      "defenses": [],
      "resources": [],
      "damageParts": [],
      "modes": [],
      "grants": [],
      "choices": [],
