    {
      "schemaVersion": 2,
      "id": "pack_dm_draconic_boons:boon_absorb_magic",
      "name": "Absorb Magic",
      "type": "DM Boon",
      "source": "DM Draconic Defence Path (A77)",
      "benefit": "Immediate Action: +2 Competence save vs targeted spell. If saved, gain 10 Temp HP per spell level (EONT) and inflict Slowed (Ref), Sickened (Fort), or Confused (Will) on caster.",
      "description": "Gain +2 competence bonus on saves vs a spell that targets you. If saved, gain 10 temporary HP for each spell level dispelled this way (EONT). Caster of the saved spell gets (EONT): if Reflex spell: Slowed; if Fort spell: Sickened; if Will spell: Confused.",
      "action": "Immediate Action",
      "actionType": "immediate",
      "modifiers": [
        { "target": "save.all", "op": "add", "value": 2, "type": "Competence", "when": { "toggle": "vs_targeted_spell" } }
      ],
      "defenses": [],
      "resources": [],
      "damageParts": [],
      "modes": [
        {
          "id": "absorb_spell_save",
          "name": "Absorb Saved Spell (Temp HP)",
          "actionType": "immediate",
          "reactsTo": "on_spell_targeted",
          "inputs": [
            { "id": "spellLevel", "label": "Saved Spell Level", "type": "int", "min": 1, "max": 9, "default": 3 }
          ],
          "spawnsBuff": {
            "id": "buff_absorb_magic_temp_hp",
            "name": "Absorb Magic (EONT)",
            "durationRounds": 1,
            "tempHpFormula": "10 * @input.spellLevel",
            "modifiers": [],
            "defenses": []
          },
          "damageParts": [],
          "modifiers": []
        }
      ],
      "grants": [],
      "choices": [],
      "tags": ["draconic", "defence_path", "immediate", "dm_boon"]
    },
    {
      "schemaVersion": 2,
      "id": "pack_dm_draconic_boons:boon_elemental_accustomed",
      "name": "Elemental Accustomed",
      "type": "DM Boon",
      "source": "DM Draconic Defence Path (A89)",
      "benefit": "Full Acid Immunity. In Marsh/Bog/Swamp: ignore difficult terrain, +10 Outdoorsman & Stealth, +3 Natural Armor, and DR 3/-.",
      "description": "Gain full immunity to ancestral element (Acid). Ancestral terrain (Marsh, Bog, Swamp) is favored terrain: ignore difficult terrain, gain +10 Outdoorsman and Stealth, +3 Natural Armor, and DR 3/-.",
      "action": "Passive",
      "actionType": "passive",
      "modifiers": [
        { "target": "ac.natural", "op": "add", "value": 3, "type": "Untyped", "when": { "terrain": ["marsh", "bog", "swamp"] } }
      ],
      "defenses": [
        { "kind": "immunity", "target": "acid" },
        { "kind": "dr", "target": "physical", "value": 3, "bypass": "-", "when": { "terrain": ["marsh", "bog", "swamp"] } }
      ],
      "resources": [],
      "damageParts": [],
      "modes": [],
      "grants": [],
      "choices": [],
      "tags": ["draconic", "defence_path", "acid", "dm_boon"]
